<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The hardened runtime's entitlements for the signed release (scripts/bundle-macos.sh
     --identity). Only the microphone: the hardened runtime blocks it without this line.
     Accessibility and Input Monitoring are granted by the user in System Settings and need no
     entitlement. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
