{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HyperMe",
  "identifier": "org.hyperme.HyperMe",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../web"
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/AndresHG/hyperme/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFRkM5RkQyNDQwQjEyMEYKUldRUEVndEUwcC84N3MxY3IwdjZuWTQ4T3lZdmpqNSsvRXVHL1p4R3p0bTZWc0tyUHdNUzAvK3oK",
      "requireSignedVersion": true
    }
  }
}
